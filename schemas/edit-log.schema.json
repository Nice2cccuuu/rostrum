    "Patch": {
      "additionalProperties": false,
      "description": "An atomic, reviewable batch of operations.\n\nA patch is all-or-nothing: either every op applies or the deck is left\nuntouched, so a partially understood instruction cannot leave the deck in a\nhalf-edited state.",
      "properties": {
        "patch_id": {
          "title": "Patch Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "utterance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The user's original request, kept verbatim for audit.",
          "title": "Utterance"
        },
        "selection": {
          "description": "Uids the user had selected in the preview, if any. Lets 'make this shorter' resolve without a textual description of the target.",
          "items": {
            "type": "string"
          },
          "title": "Selection",
          "type": "array"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "delete_block": "#/$defs/DeleteBlock",
                "insert_block": "#/$defs/InsertBlock",
                "merge_blocks": "#/$defs/MergeBlocks",
                "move_block": "#/$defs/MoveBlock",
                "pin": "#/$defs/Pin",
                "reorder_slides": "#/$defs/ReorderSlides",
                "replace_asset": "#/$defs/ReplaceAsset",
                "retime": "#/$defs/Retime",
                "rewrite": "#/$defs/Rewrite",
                "set_backup": "#/$defs/SetBackup",
                "set_caption": "#/$defs/SetCaption",
                "set_channel": "#/$defs/SetChannel",
                "set_dwell": "#/$defs/SetDwell",
                "set_importance": "#/$defs/SetImportance",
                "set_slide_role": "#/$defs/SetSlideRole",
                "set_style": "#/$defs/SetStyle",
                "set_text": "#/$defs/SetText",
                "set_title": "#/$defs/SetTitle",
                "split_block": "#/$defs/SplitBlock",
                "split_slide": "#/$defs/SplitSlide"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SetText"
              },
              {
                "$ref": "#/$defs/Rewrite"
              },
              {
                "$ref": "#/$defs/SplitBlock"
              },
              {
                "$ref": "#/$defs/MergeBlocks"
              },
              {
                "$ref": "#/$defs/DeleteBlock"
              },
              {
                "$ref": "#/$defs/InsertBlock"
              },
              {
                "$ref": "#/$defs/SetChannel"
              },
              {
                "$ref": "#/$defs/SetImportance"
              },
              {
                "$ref": "#/$defs/Pin"
              },
              {
                "$ref": "#/$defs/SetDwell"
              },
              {
                "$ref": "#/$defs/Retime"
              },
              {
                "$ref": "#/$defs/MoveBlock"
              },
              {
                "$ref": "#/$defs/ReorderSlides"
              },
              {
                "$ref": "#/$defs/SplitSlide"
              },
              {
                "$ref": "#/$defs/SetSlideRole"
              },
              {
                "$ref": "#/$defs/SetBackup"
              },
              {
                "$ref": "#/$defs/SetTitle"
              },
              {
                "$ref": "#/$defs/ReplaceAsset"
              },
              {
                "$ref": "#/$defs/SetCaption"
              },
              {
                "$ref": "#/$defs/SetStyle"
              }
            ]
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interpreter confidence. Low-confidence patches should be shown as a proposed diff for confirmation rather than auto-applied.",
          "title": "Confidence"
        }
      },
      "required": [
        "patch_id",
        "operations"
      ],
      "title": "Patch",
      "type": "object"
    },
