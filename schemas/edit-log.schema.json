{
  "$defs": {
    "Channel": {
      "description": "Dual-track routing target.\n\nThis is the field that implements the \"what goes on the slide vs. what the\npresenter merely says\" split. Both channels are projections of the *same*\ncontent tree, which is what keeps the spoken script and the slides from\ndrifting apart.",
      "enum": [
        "slide",
        "script",
        "drop"
      ],
      "title": "Channel",
      "type": "string"
    },
    "DeleteBlock": {
      "additionalProperties": false,
      "description": "Soft delete: routes to the ``drop`` channel so the decision is reversible.",
      "properties": {
        "target": {
          "description": "Opaque uid of the node being edited. Never a path.",
          "title": "Target",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this op was emitted, quoting the user's phrasing. Shown in the edit history so a later reader can tell intent from accident.",
          "title": "Rationale"
        },
        "op": {
          "const": "delete_block",
          "default": "delete_block",
          "title": "Op"
        },
        "hard": {
          "default": false,
          "description": "Remove from the tree entirely rather than marking dropped.",
          "title": "Hard",
          "type": "boolean"
        }
      },
      "required": [
        "target"
      ],
      "title": "DeleteBlock",
      "type": "object"
    },
    "Density": {
      "description": "User preference for how much text lands on each slide.\n\nResolved into concrete numeric caps by\n:mod:`rostrum.budget.density`, so downstream code never branches on the\nenum directly.",
      "enum": [
        "sparse",
        "balanced",
        "compact"
      ],
      "title": "Density",
      "type": "string"
    },
    "InsertBlock": {
      "additionalProperties": false,
      "description": "Insert a new block relative to ``target``.",
      "properties": {
        "target": {
          "description": "Opaque uid of the node being edited. Never a path.",
          "title": "Target",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this op was emitted, quoting the user's phrasing. Shown in the edit history so a later reader can tell intent from accident.",
          "title": "Rationale"
        },
        "op": {
          "const": "insert_block",
          "default": "insert_block",
          "title": "Op"
        },
        "position": {
          "default": "after",
          "enum": [
            "before",
            "after",
            "append"
          ],
          "title": "Position",
          "type": "string"
        },
        "block": {
          "description": "Serialised Block payload, validated on apply.",
          "title": "Block",
          "type": "object"
        }
      },
      "required": [
        "target",
        "block"
      ],
      "title": "InsertBlock",
      "type": "object"
    },
